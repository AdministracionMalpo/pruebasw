# =====================================================================
#  Portal Malpo · variables de entorno
#  Mismos nombres y patrón que el .env de Adquisiciones.
#  Copie este archivo como .env y complete los valores (KEY, KEY2, USERNAME,
#  PASSWORD y API_SESION_URL son los mismos que usa Adquisiciones).
# =====================================================================

# Id NUEVO de la plataforma "Portal Malpo" en master_innova
# (lo muestra sql/03_master_innova_alta_plataforma.sql de api_portal_malpo). NO usar 107.
NEXT_PUBLIC_ID_PLATAFORMA='000'

# api_maestra: login y sesión (igual que Adquisiciones)
NEXT_PUBLIC_API_SESION_URL='http://localhost/api_master/api_maestra/'
NEXT_PUBLIC_SMTP_API_MAESTRA_KEY='<misma KEY que Adquisiciones>'
NEXT_PUBLIC_SMTP_API_MAESTRA_USERNAME='<mismo USERNAME que Adquisiciones>'
NEXT_PUBLIC_SMTP_API_MAESTRA_PASSWORD='<mismo PASSWORD que Adquisiciones>'

# URL donde corre este portal (Adquisiciones usa 3000; el portal usa 3001)
NEXT_PUBLIC_API_SESION_URL3='http://localhost:3001'

# API de negocio PROPIA del portal (no api_bodegas)
NEXT_PUBLIC_API_URL='http://localhost/api_master/api_portal_malpo/'
NEXT_PUBLIC_SMTP_API_MAESTRA_KEY2='<misma KEY2 que Adquisiciones>'

# Opcional: '1' para llamar a la API a través de Next (/api/portal/...) si el navegador
# no puede llegar directo a NEXT_PUBLIC_API_URL (CORS, https/http mixto, red interna).
NEXT_PUBLIC_API_PROXY='0'
